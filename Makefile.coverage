# Makefile for C code coverage analysis with gcov
# This extends the main Makefile with coverage-specific targets

include Makefile

# Coverage-specific flags
COVERAGE_CFLAGS = -fprofile-arcs -ftest-coverage -O0
# Coverage linker flags - different for macOS/Apple clang
ifeq ($(shell uname),Darwin)
    # On macOS with Apple clang, coverage is built-in, no need for -lgcov
    COVERAGE_LDFLAGS = --coverage
else
    # On Linux/GCC, need to link with gcov
    COVERAGE_LDFLAGS = -lgcov --coverage
endif

# Coverage output directory
COVERAGE_DIR = c_coverage

# Coverage library name
COVERAGE_LIB = priv/fdb_nif_coverage.so

# Build with coverage instrumentation
$(COVERAGE_LIB): c_src/fdb_nif.c
	$(CC) $(CFLAGS) $(COVERAGE_CFLAGS) -shared $(LDFLAGS) $(COVERAGE_LDFLAGS) -o $@ c_src/fdb_nif.c

# Build with coverage
coverage-build: clean-coverage $(COVERAGE_LIB)
	@echo "Built NIF with coverage instrumentation"

# Run tests with coverage build
coverage-test: coverage-build
	@echo "Running tests with coverage-instrumented NIF..."
	@# Backup original NIF
	@if [ -f $(LIB_NAME) ]; then mv $(LIB_NAME) $(LIB_NAME).backup; fi
	@# Use coverage NIF
	@cp $(COVERAGE_LIB) $(LIB_NAME)
	@# Run tests
	mix test test/fdb/native/
	@# Restore original NIF
	@if [ -f $(LIB_NAME).backup ]; then mv $(LIB_NAME).backup $(LIB_NAME); fi

# Generate coverage report
coverage-report: coverage-test
	@echo "Generating coverage report..."
	@mkdir -p $(COVERAGE_DIR)
	@# Copy source files to coverage directory
	@cp c_src/*.c $(COVERAGE_DIR)/
	@# Generate coverage data
	@gcov -o priv/fdb_nif_coverage.so-fdb_nif.gcda c_src/fdb_nif.c
	@# Move any gcov files to coverage directory
	@mv *.gcov $(COVERAGE_DIR)/ 2>/dev/null || true
	@# Generate HTML report with lcov if available
	@if command -v lcov >/dev/null 2>&1; then \
		echo "Generating HTML report with lcov..."; \
		lcov --capture --directory . --output-file $(COVERAGE_DIR)/coverage.info --rc lcov_branch_coverage=1; \
		genhtml $(COVERAGE_DIR)/coverage.info --output-directory $(COVERAGE_DIR)/html --branch-coverage; \
		echo "HTML report generated in $(COVERAGE_DIR)/html/index.html"; \
	else \
		echo "lcov not found. Install it for HTML reports: brew install lcov (macOS) or apt-get install lcov (Linux)"; \
	fi
	@# Display text summary
	@echo ""
	@echo "Coverage Summary:"
	@echo "================="
	@# Show coverage percentage from gcov output
	@if [ -f $(COVERAGE_DIR)/fdb_nif.c.gcov ]; then \
		echo "File: c_src/fdb_nif.c"; \
		awk '/^Lines executed:/ {print $$0; exit}' $(COVERAGE_DIR)/fdb_nif.c.gcov || echo "Coverage data available in $(COVERAGE_DIR)/fdb_nif.c.gcov"; \
	else \
		echo "No coverage data found. Check $(COVERAGE_DIR)/ for details."; \
	fi
	@echo ""
	@echo "Detailed coverage in $(COVERAGE_DIR)/"

# Generate coverage report with llvm-cov (for clang)
coverage-llvm: clean-coverage
	@echo "Building with clang coverage..."
	@# Build with clang coverage flags
	clang $(CFLAGS) -fprofile-instr-generate -fcoverage-mapping -shared $(LDFLAGS) -o $(COVERAGE_LIB) c_src/fdb_nif.c
	@# Backup and replace NIF
	@if [ -f $(LIB_NAME) ]; then mv $(LIB_NAME) $(LIB_NAME).backup; fi
	@cp $(COVERAGE_LIB) $(LIB_NAME)
	@# Run tests
	LLVM_PROFILE_FILE="fdb_nif-%p.profraw" mix test test/fdb/native/
	@# Restore NIF
	@if [ -f $(LIB_NAME).backup ]; then mv $(LIB_NAME).backup $(LIB_NAME); fi
	@# Process coverage data
	@mkdir -p $(COVERAGE_DIR)
	llvm-profdata merge -sparse fdb_nif-*.profraw -o $(COVERAGE_DIR)/fdb_nif.profdata
	llvm-cov show $(COVERAGE_LIB) -instr-profile=$(COVERAGE_DIR)/fdb_nif.profdata c_src/fdb_nif.c > $(COVERAGE_DIR)/coverage.txt
	llvm-cov report $(COVERAGE_LIB) -instr-profile=$(COVERAGE_DIR)/fdb_nif.profdata c_src/fdb_nif.c
	@# Generate HTML if possible
	llvm-cov show $(COVERAGE_LIB) -instr-profile=$(COVERAGE_DIR)/fdb_nif.profdata c_src/fdb_nif.c -format=html -output-dir=$(COVERAGE_DIR)/html
	@echo "HTML report generated in $(COVERAGE_DIR)/html/index.html"
	@rm -f fdb_nif-*.profraw

# Clean coverage files
clean-coverage:
	rm -rf $(COVERAGE_DIR)
	rm -f *.gcda *.gcno *.gcov
	rm -f $(COVERAGE_LIB)
	rm -f fdb_nif-*.profraw
	rm -f $(LIB_NAME).backup

# Full clean including coverage
clean-all: clean clean-coverage

# Help
coverage-help:
	@echo "Coverage targets:"
	@echo "  make -f Makefile.coverage coverage-report  - Run tests and generate gcov coverage report"
	@echo "  make -f Makefile.coverage coverage-llvm    - Run tests and generate llvm-cov coverage report (requires clang)"
	@echo "  make -f Makefile.coverage clean-coverage   - Clean all coverage files"
	@echo ""
	@echo "Requirements:"
	@echo "  - For gcov: GCC compiler"
	@echo "  - For llvm-cov: Clang compiler"
	@echo "  - For HTML reports: lcov (optional but recommended)"
	@echo ""
	@echo "Install lcov:"
	@echo "  macOS:   brew install lcov"
	@echo "  Ubuntu:  apt-get install lcov"
	@echo "  RHEL:    yum install lcov"

.PHONY: coverage-build coverage-test coverage-report coverage-llvm clean-coverage clean-all coverage-help
